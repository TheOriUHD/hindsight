{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hindsight",
  "version": "0.1.0",
  "identifier": "app.hindsight.clips",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Hindsight",
    "shortDescription": "Instant replay clipping",
    "longDescription": "Always-on replay buffer: press a hotkey, get the last moments as a clip. No accounts, no cloud.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../vendor/ffmpeg/bin/avcodec-62.dll": "avcodec-62.dll",
      "../vendor/ffmpeg/bin/avdevice-62.dll": "avdevice-62.dll",
      "../vendor/ffmpeg/bin/avfilter-11.dll": "avfilter-11.dll",
      "../vendor/ffmpeg/bin/avformat-62.dll": "avformat-62.dll",
      "../vendor/ffmpeg/bin/avutil-60.dll": "avutil-60.dll",
      "../vendor/ffmpeg/bin/swresample-6.dll": "swresample-6.dll",
      "../vendor/ffmpeg/bin/swscale-9.dll": "swscale-9.dll",
      "../vendor/ffmpeg/bin/ffmpeg.exe": "ffmpeg.exe",
      "../vendor/ffmpeg/LICENSE.txt": "FFMPEG-LICENSE.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
