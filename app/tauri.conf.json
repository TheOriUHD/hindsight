{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hindsight",
  "version": "1.0.0",
  "identifier": "app.hindsight.clips",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Hindsight",
    "shortDescription": "Instant replay clipping for Windows",
    "longDescription": "Hindsight keeps the last minutes of your screen on the GPU. Press a key and they are saved as an MP4. No account, no uploads.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../vendor/ffmpeg/bin/avcodec-62.dll": "avcodec-62.dll",
      "../vendor/ffmpeg/bin/avdevice-62.dll": "avdevice-62.dll",
      "../vendor/ffmpeg/bin/avfilter-11.dll": "avfilter-11.dll",
      "../vendor/ffmpeg/bin/avformat-62.dll": "avformat-62.dll",
      "../vendor/ffmpeg/bin/avutil-60.dll": "avutil-60.dll",
      "../vendor/ffmpeg/bin/swresample-6.dll": "swresample-6.dll",
      "../vendor/ffmpeg/bin/swscale-9.dll": "swscale-9.dll",
      "../vendor/ffmpeg/bin/ffmpeg.exe": "ffmpeg.exe",
      "../vendor/ffmpeg/LICENSE.txt": "FFMPEG-LICENSE.txt",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "copyright": "Copyright (c) 2026 TheOriUHD",
    "category": "Video",
    "homepage": "https://hindsighthq.app"
  }
}